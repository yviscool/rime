{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "types": ["bun"]
  },
  "include": [
    "sdk/**/*.ts",
    "tools/**/*.ts",
    "apps/**/*.ts",
    "plugins/**/*.ts",
    "tests/**/*.ts",
    "contracts/generated/**/*.ts"
  ]
}
