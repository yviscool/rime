{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "types": ["bun"],
    "paths": {
      "@rime/sdk": ["./sdk/src/index.ts"],
      "@rime/sdk/*": ["./sdk/src/*"]
    }
  },
  "include": [
    "sdk/**/*.ts",
    "tools/**/*.ts",
    "apps/**/*.ts",
    "plugins/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "contracts/generated/**/*.ts"
  ]
}
