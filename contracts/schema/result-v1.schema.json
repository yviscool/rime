{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rime.runtime/contracts/result-v1.schema.json",
  "title": "Rime Action Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actionId", "status", "error"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "actionId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "status": { "enum": ["succeeded", "failed", "cancelled"] },
    "value": { "type": "object" },
    "error": { "$ref": "#/$defs/error" }
  },
  "$defs": {
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": ["none", "invalid_state", "queue_closed", "queue_full", "cancelled", "timeout", "capability_denied", "invalid_contract", "unsupported", "execution_failed", "target_gone"]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
