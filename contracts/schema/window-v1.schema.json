{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rime.runtime/contracts/window-v1.schema.json",
  "title": "Rime Window Query v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1, "description": "Vocabulary marker only; never sent on the wire." },
    "title": { "type": "string", "description": "Title filter, case-sensitive in every match mode (AHK rule); matchMode regex reads it as an AHK regex where the i) option prefix opts into case-insensitivity." },
    "matchMode": { "enum": ["startswith", "contains", "exact", "regex"], "default": "contains", "description": "Title match mode; when absent the query resolves against the runtime's global titleMatchMode setting (default contains)." },
    "ahkClass": { "type": "string", "minLength": 1, "description": "Case-insensitive Win32 class-name filter." },
    "ahkExe": { "type": "string", "minLength": 1, "description": "Case-insensitive filter on the process image basename only; directory parts are ignored." },
    "ahkId": { "type": ["string", "integer"], "minLength": 1 },
    "includeHidden": { "type": "boolean", "description": "When true, hidden windows are included; when absent the global detectHiddenWindows setting (default false) decides; title-less windows are always filtered out." },
    "active": { "type": "boolean" },
    "until": { "enum": ["exists", "active", "closed", "notActive"], "default": "exists", "description": "WinWait family condition (windows.wait): a matching window appears / becomes foreground / no longer exists / stops being foreground." }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer" },
        "top": { "type": "integer" },
        "right": { "type": "integer" },
        "bottom": { "type": "integer" }
      }
    },
    "state": { "enum": ["normal", "minimized", "maximized", "hidden"] },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "className",
        "processName",
        "processPath",
        "rect",
        "clientRect",
        "visible",
        "minimized",
        "state",
        "processId",
        "style",
        "exStyle",
        "enabled",
        "alwaysOnTop",
        "minMax",
        "transparent",
        "transColor",
        "region"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "title": { "type": "string" },
        "className": { "type": "string" },
        "processName": { "type": "string" },
        "processPath": { "type": "string" },
        "rect": { "$ref": "#/$defs/rect" },
        "clientRect": { "$ref": "#/$defs/rect" },
        "visible": { "type": "boolean" },
        "minimized": { "type": "boolean" },
        "state": { "$ref": "#/$defs/state" },
        "processId": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "style": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "exStyle": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "enabled": { "type": "boolean" },
        "alwaysOnTop": { "type": "boolean" },
        "minMax": { "enum": [-1, 0, 1] },
        "transparent": { "type": "integer", "minimum": -1, "maximum": 255 },
        "transColor": { "type": "string", "pattern": "^$|^0x[0-9A-F]{6}$" },
        "region": { "type": "string", "description": "Region bounding box as \"left,top,right,bottom\" in window coordinates, or \"\" when the window has no region." }
      }
    },
    "placement": { "enum": ["left", "right", "top", "bottom", "full"] },
    "movePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position"],
      "properties": {
        "position": { "$ref": "#/$defs/placement" }
      }
    },
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "zorderPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement"],
      "properties": {
        "placement": { "enum": ["top", "bottom"], "description": "Where to move the window in the z-order (WinMoveTop/WinMoveBottom); no move, no resize, no activation." }
      }
    },
    "groupAddPayload": {
      "type": "object",
      "additionalProperties": false,
      "description": "window.group.add payload: one query spec. At least one selector field (title/ahkClass/ahkExe/ahkId/active) is required; the executor enforces that rule (the schema subset cannot express it) and rejects the empty spec AHK tolerates as a placeholder.",
      "properties": {
        "title": { "type": "string", "description": "Title filter, case-sensitive in every match mode (AHK rule)." },
        "matchMode": { "enum": ["startswith", "contains", "exact", "regex"], "default": "contains" },
        "ahkClass": { "type": "string", "minLength": 1 },
        "ahkExe": { "type": "string", "minLength": 1 },
        "ahkId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "includeHidden": { "type": "boolean" },
        "active": { "type": "boolean" }
      }
    },
    "groupFocusPayload": {
      "type": "object",
      "additionalProperties": false,
      "description": "window.group.activate / window.group.deactivate payload: cycle direction only.",
      "properties": {
        "reverse": { "type": "boolean", "default": false, "description": "Start the cycle at the most recent (top) member instead of the oldest." }
      }
    },
    "groupClosePayload": {
      "type": "object",
      "additionalProperties": false,
      "description": "window.group.close payload: AHK GroupClose's mode.",
      "properties": {
        "mode": { "enum": ["", "reverse", "all"], "default": "", "description": "'' closes the foreground member then activates the next; 'reverse' walks from the most recent member; 'all' closes every member and activates nothing." }
      }
    },
    "setTitlePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "description": "New window title (WinSetTitle); the empty string clears the title." }
      }
    },
    "setEnabledPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "enum": [-1, 0, 1], "description": "WinSetEnabled: 1 enables, 0 disables, -1 toggles the current state." }
      }
    },
    "setAlwaysOnTopPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "enum": [-1, 0, 1], "default": 1, "description": "WinSetAlwaysOnTop: 1 makes topmost, 0 clears topmost, -1 toggles; absent means 1 (AHK's default)." }
      }
    },
    "setStylePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "description": "WinSetStyle/WinSetExStyle change string: '+N' adds, '-N' removes, '^N' toggles, a bare N replaces the whole style; N is decimal or 0x-hex and fits 32 bits." }
      }
    },
    "setTransparentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "integer", "minimum": -1, "maximum": 255, "description": "WinSetTransparent: 0..255 sets the layered alpha, -1 turns transparency off (drops WS_EX_LAYERED)." }
      }
    },
    "setTransColorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "description": "WinSetTransColor: '' or 'off' clears the color key, 'RRGGBB'/'0xRRGGBB' sets it (hex only), a ' <0-255>' suffix adds the alpha alongside." }
      }
    },
    "setRegionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "description": "WinSetRegion options: '<x>-<y>' coordinate pairs (first pair anchors the shape) plus the letter options E (ellipse), R[<rrw>-<rrh>] (rounded rectangle, default 30x30), W[<width>]/Wind (width or winding fill) and H<height>; numbers are signed decimal and '' restores the normal window region." }
      }
    },
    "actionType": {
      "enum": [
        "window.move",
        "window.focus",
        "window.close",
        "window.hide",
        "window.show",
        "window.minimize",
        "window.maximize",
        "window.restore",
        "window.zorder",
        "window.kill",
        "window.redraw",
        "window.group.add",
        "window.group.activate",
        "window.group.deactivate",
        "window.group.close",
        "window.minimizeall",
        "window.minimizeall.undo",
        "window.set.title",
        "window.set.enabled",
        "window.set.alwaysontop",
        "window.set.style",
        "window.set.exstyle",
        "window.set.transparent",
        "window.set.transcolor",
        "window.set.region"
      ]
    }
  }
}
